# .env.example — MINERVA wave 0 (VARIABLES ONLY, no values)
#
# The REAL values live in the repo-root .env.local (git-ignored) and in
# Supabase/Cloudflare secret stores (AD-3: no key ever on the device).
# This file documents WHICH variables the wave-0 scripts/EFs read so CI and
# local runs can be wired. NEVER commit real secrets.

# --- Supabase (AD-16, 01 §2.2) ---------------------------------------------
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_JWKS_URL=

# --- PowerSync relay (03 §5.5, docs/architecture/contract-catalog.md §6) ----
POWERSYNC_URL=
PS_ADMIN_TOKEN=

# --- Cloudflare R2 (AD-16, 01 §5.4 / docs/cloudflare/r2.md §1 SSoT) --------
# Lead decision (wave 0): 1 PRIVATE bucket PER ENVIRONMENT =
#   aurora-files-{dev,staging,prod}
# The current .env.local values (aurora-artifacts-prod, aurora-media-prod)
# are the EXISTING prod deploy (data wave-0, OQ-03). The frozen convention is
# 1 bucket/env; the mapping is recorded in this file, not hardcoded.
CF_ACCOUNT_ID=
CF_API_TOKEN=
R2_BUCKET_DEV=
R2_BUCKET_STAGING=
R2_BUCKET_PROD=
R2_S3_ENDPOINT=

# --- Cloudflare AI Gateway (AD-4, 01 §5.6) ---------------------------------
CF_AI_GATEWAY_ID=
CF_API_WORKERS_AI_TOKEN=
CF_CUSTOM_PROVIDER_AGNES=

# --- LLM providers (AI SDK router, AD-3: keys server-side ONLY) ------------
# The S2.6 chain in failover order:
#   1. agnes (dual-key failover: AGNES_API_KEY_1 → AGNES_API_KEY_2 on 429/error)
#   2. workers-ai (via CF_API_WORKERS_AI_TOKEN, scope workers-ai)
#   3. groq
#   4. openrouter
# No key → provider hidden from the device model picker + AD-5 cooldown applies.
AGNES_API_KEY_1=
AGNES_API_KEY_2=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Research providers (ResearchProvider port, NOT the LLM router) --------
# 3 tiers: primary → secondary → tertiary; absent → "uncertain" (AD-1 last
# paragraph, graceful degradation). Consumed by fn-agent-run / jobs (C
# category).
EXA_API_KEY=
TAVILY_API_KEY=
YOU_API_KEY=

# --- Integration providers (IntegrationProvider port, Composio) ------------
COMPOSIO_API_KEY=

# --- OneSignal (NotificationProvider, mobile Phase 1, ADR §13) -------------
ONESIGNAL_APP_ID=
ONESIGNAL_REST_API_KEY=

# --- Observability (AD-8/AD-16d) -------------------------------------------
SENTRY_DSN=
POSTHOG_API_KEY=
POSTHOG_HOST=
